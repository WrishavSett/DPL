# --- FastAPI / Uvicorn ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# --- Database ---
DB_PATH=db/tracking.db

# --- Model (default; can be overridden per-camera in the cameras table) ---
MODEL_PATH=models/yolo11n.pt
DEVICE=cpu

# --- Inference defaults (per-camera overrides live in the DB, these are fallbacks) ---
TARGET_W=640
TARGET_H=480
CONF_THRESHOLD=0.5
IOU_THRESHOLD=0.5
LOST_TRACK_BUFFER=30
DEFAULT_CLASSES=person

# --- Reports ---
REPORTS_DIR=reports
REPORT_INTERVAL_HOURS=1

# --- Logs ---
LOGS_DIR=logs
LOG_LEVEL=INFO

# --- Worker / streaming ---
FRAME_JPEG_QUALITY=80
WORKER_HEARTBEAT_INTERVAL=5
WORKER_HEARTBEAT_TIMEOUT=15

# --- Scheduler ---
SCHEDULER_TIMEZONE=UTC
